		["C4"]            = { DefaultSlot = 3, Color = Color3.fromRGB(115, 19, 134) },
		["Taser"]         = { DefaultSlot = 4, Color = Color3.fromRGB(31, 119, 190) },
		["Handcuffs"]     = { DefaultSlot = 5, Color = Color3.fromRGB(31, 119, 190) },
		["Key-Card"]      = { DefaultSlot = 5, Color = Color3.fromRGB(115, 19, 134) },
		["Breakfast"]     = { DefaultSlot = 5, Color = Color3.fromRGB(115, 19, 134) },
		["Lunch"]         = { DefaultSlot = 5, Color = Color3.fromRGB(115, 19, 134) },
		["Dinner"]        = { DefaultSlot = 5, Color = Color3.fromRGB(115, 19, 134) },
	}

	local function CleanConnections()
		for _, conn in ipairs(charConnections) do
			if conn then conn:Disconnect() end
		end
		table.clear(charConnections)
	end

	local function ToolExists(tool: Tool): boolean
		for _, v in pairs(CurrentHotbar) do
			if v == tool then return true end
		end
		return table.find(InventoryTools, tool) ~= nil
	end

	local function RegisterTool(tool: Tool)
		if not tool:IsA("Tool") or ToolExists(tool) then return end

		local data = SLOT_DATA[tool.Name]
		if data and data.DefaultSlot then
			local preferred = data.DefaultSlot
			if not CurrentHotbar[preferred] then
				CurrentHotbar[preferred] = tool
				return
			end
		end

		for i = 1, 5 do
			if not CurrentHotbar[i] then
				CurrentHotbar[i] = tool
				return
			end
		end
		table.insert(InventoryTools, tool)
	end

	local function RemoveTool(tool: Tool)
		for i, v in pairs(CurrentHotbar) do
			if v == tool then CurrentHotbar[i] = nil end
		end
		local index = table.find(InventoryTools, tool)
		if index then table.remove(InventoryTools, index) end
	end

	local function EndDrag()
		if DragFrame then DragFrame:Destroy() end
		DragFrame = nil
		DraggingTool = nil
	end

	local function CreateSlot(index: number, inventory: boolean): Frame
		local Slot = Instance.new("Frame")
		Slot.Name = "Slot" .. index

		if inventory then
			Slot.Size = UDim2.new(0.175,0,0.95,0)
		else
			Slot.Size = UDim2.new(0.325,0,1,0)
		end

		Slot.BackgroundColor3 = Color3.fromRGB(157,150,148)
		Slot.BackgroundTransparency = 0.5
		Slot.BorderColor3 = Color3.new(1,1,1)
		Slot.BorderSizePixel = 0

		local Scale = Instance.new("UIScale")
		Scale.Name = "SelectionScale"
		Scale.Parent = Slot

		local Icon = Instance.new("ImageLabel")
		Icon.Name = "Icon"
		Icon.BackgroundTransparency = 1
		Icon.Size = UDim2.new(1,0,1,0)
		Icon.Image = "rbxassetid://93481383611512"
		Icon.ScaleType = Enum.ScaleType.Fit
		Icon.ImageRectSize = Vector2.new(256,128)
		Icon.BorderSizePixel = 0
		Icon.Visible = false
		Icon.Parent = Slot

		local UiShadow = Instance.new("UIShadow")
		UiShadow.BlurRadius = UDim.new(0.05, 0)
		UiShadow.Color = Slot.BackgroundColor3
		UiShadow.Spread = UDim2.new(0.05, 0,0.05, 0)
		UiShadow.Transparency = 0.65
		UiShadow.Parent = Slot
		UiShadow.Enabled = GlobalSettings.UIShadowsEnabled

		local Gradient = Instance.new("UIGradient")
		Gradient.Name = "Gradient"
		Gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 200, 200)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
		})
		Gradient.Parent = Icon
		Gradient.Rotation = 90

		local Gradient2 = Instance.new("UIGradient")
		Gradient2.Name = "Gradient"
		Gradient2.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 200, 200)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
		})
		Gradient2.Parent = Slot
		Gradient2.Rotation = 90

		local Vignette = Instance.new("ImageLabel")
		Vignette.Name = "Vignette"
		Vignette.BackgroundTransparency = 1
		Vignette.Size = UDim2.new(1,0,1,0)
		Vignette.Image = "rbxassetid://3156051337"
		Vignette.ImageTransparency = 0.65
		Vignette.Parent = Slot
		Vignette.Visible = true

		local Label = Instance.new("TextLabel")
		Label.Name = "SlotLabel"
		Label.BackgroundTransparency = 1
		Label.Size = UDim2.new(1,0,1,0)
		Label.TextScaled = true
		Label.TextColor3 = Color3.new(1,1,1)
		Label.Text = ""
		Label.Parent = Slot

		local Button = Instance.new("ImageButton")
		Button.Name = "Button"
		Button.BackgroundTransparency = 1
		Button.ImageTransparency = 1
		Button.AutoButtonColor = false
		Button.Size = UDim2.new(1,0,1,0)
		Button.Parent = Slot

		local AmoFrame = Instance.new("Frame")
		AmoFrame.Name = "AmoFrame"
		AmoFrame.AnchorPoint = Vector2.new(0, 1)
		AmoFrame.Position = UDim2.fromScale(0, 1)
		AmoFrame.Size = UDim2.fromScale(1, 0.25)
		AmoFrame.BackgroundTransparency = 1
		AmoFrame.ZIndex = 2
		AmoFrame.Parent = Slot

		local SlotAmoLabel = Instance.new("TextLabel")
		SlotAmoLabel.Name = "AmoLabel"
		SlotAmoLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		SlotAmoLabel.Position = UDim2.fromScale(0.5, 0.5)
		SlotAmoLabel.Size = UDim2.fromScale(0.8, 1)
		SlotAmoLabel.TextScaled = true
		SlotAmoLabel.Font = Enum.Font.Arimo
		SlotAmoLabel.Text = ""
		SlotAmoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		SlotAmoLabel.TextStrokeTransparency = 1
		SlotAmoLabel.BackgroundTransparency = 1
		SlotAmoLabel.TextXAlignment = Enum.TextXAlignment.Right
		SlotAmoLabel.ZIndex = 2
		SlotAmoLabel.Parent = AmoFrame

		return Slot
	end

	local function UpdateSlot(slot: Frame, tool: Tool?, equipped: boolean)
		local icon = slot:FindFirstChild("Icon") :: ImageLabel
		local label = slot:FindFirstChild("SlotLabel") :: TextLabel
		local scale = slot:FindFirstChild("SelectionScale") :: UIScale
		local shadow = slot:FindFirstChild("UIShadow") :: UIShadow

		icon.Visible = false
		label.Text = ""
		scale.Scale = 1
		slot.BackgroundTransparency = 0.5
		slot.BackgroundColor3 = Color3.fromRGB(157, 150, 148)
		shadow.Color = Color3.fromRGB(157, 150, 148)

		if not tool then return end

		local data = SLOT_DATA[tool.Name]
		if data then
			if data.Offset then
				icon.Visible = true
				icon.ImageRectOffset = data.Offset
			else
				label.Text = tool.Name
			end
			slot.BackgroundTransparency = data.Transparency or 0
			slot.BackgroundColor3 = data.Color or Color3.fromRGB(157, 150, 148)
			shadow.Color = data.Color or Color3.fromRGB(157, 150, 148)
		else
			label.Text = tool.Name
		end

		if equipped then
			scale.Scale = 1.1
			slot.BackgroundTransparency = 0
		end
	end

	local function ResolveLiveTool(tool: Tool?): Tool?
		if not tool then return nil end

		local liveInCharacter = Character and Character:FindFirstChild(tool.Name)
		if liveInCharacter and liveInCharacter:IsA("Tool") then
			return liveInCharacter :: Tool
		end

		local liveInBackpack = Backpack and Backpack:FindFirstChild(tool.Name)
		if liveInBackpack and liveInBackpack:IsA("Tool") then
			return liveInBackpack :: Tool
		end

		return tool
	end

	local function UpdateSlotAmmo(slot: Frame, tool: Tool?)
		local amoFrame = slot:FindFirstChild("AmoFrame") :: Frame?
		if not amoFrame then return end
		local amoLabel = amoFrame:FindFirstChild("AmoLabel") :: TextLabel?
		if not amoLabel then return end

		if not tool then
			amoLabel.Text = ""
			return
		end

		local current = tool:GetAttribute("CurrentAmmo")
			or tool:GetAttribute("CurrentAmo")
			or tool:GetAttribute("Local_CurrentAmmo")
			or tool:GetAttribute("Local_CurrentAmo")
		local max = tool:GetAttribute("MaxAmmo") or tool:GetAttribute("MaxAmo")

		amoLabel.Text = (current and max) and (tostring(current) .. " / " .. tostring(max)) or ""
	end

	local function UpdateHotbar()
		local equippedTool = Character and Character:FindFirstChildOfClass("Tool")

		for i = 1, 5 do
			local slot = HotbarFrame:FindFirstChild("Slot" .. i) :: Frame?
			if slot then
				local tool = CurrentHotbar[i]
				UpdateSlot(slot, tool, tool == equippedTool)

				local button = slot:FindFirstChild("Button") :: ImageButton
				if not button:GetAttribute("Bound") then
					button:SetAttribute("Bound", true)
					button.MouseButton1Down:Connect(function()
						if CurrentHotbar[i] then
							DraggingTool = CurrentHotbar[i]
							DragFrame = slot:Clone()
							DragFrame.Parent = Gui
							DragFrame.AnchorPoint = Vector2.new(0.5, 0.5)
							DragFrame.Size = UDim2.fromOffset(slot.AbsoluteSize.X, slot.AbsoluteSize.Y)
							DragFrame.ZIndex = 999

							for _,obj in ipairs(DragFrame:GetDescendants()) do
								if obj:IsA("GuiObject") then
									obj.ZIndex = 999
								end
							end
						end
					end)
				end
			end
		end

		for i = 1, 5 do
			local slot = InventorySlotsFrame:FindFirstChild("Slot" .. i) :: Frame?
			if slot then
				UpdateSlot(slot, InventoryTools[i], false)

				local button = slot:FindFirstChild("Button") :: ImageButton
				if not button:GetAttribute("Bound") then
					button:SetAttribute("Bound", true)
					button.MouseButton1Down:Connect(function()
						if InventoryTools[i] then
							DraggingTool = InventoryTools[i]
							DragFrame = slot:Clone()
							DragFrame.Parent = Gui
							DragFrame.AnchorPoint = Vector2.new(0.5, 0.5)
							DragFrame.Size = UDim2.fromOffset(slot.AbsoluteSize.X, slot.AbsoluteSize.Y)
							DragFrame.ZIndex = 999

							for _,obj in ipairs(DragFrame:GetDescendants()) do
								if obj:IsA("GuiObject") then
									obj.ZIndex = 999
								end
							end

						end
					end)
				end
			end
		end
	end

	local function EquipSlot(slotName: string, inputState: Enum.UserInputState)
		if inputState ~= Enum.UserInputState.Begin or not Character then return end

		local slotNumber = tonumber(slotName:sub(-1))
		if not slotNumber then return end

		local tool = CurrentHotbar[slotNumber]
		local humanoid = Character:FindFirstChildOfClass("Humanoid")
		local currentTool = Character:FindFirstChildOfClass("Tool")

		if tool and tool.Parent == Backpack then
			if humanoid then humanoid:EquipTool(tool) end
		elseif currentTool == tool and tool ~= nil then
			if humanoid then humanoid:UnequipTools() end
		end

		return Enum.ContextActionResult.Sink
	end

	Gui = Instance.new("ScreenGui")
	Gui.Name = "HotbarGui"
	Gui.ResetOnSpawn = false
	Gui.Parent = TargetParent
	table.insert(TrackingRefs, Gui)

	HotbarFrame = Instance.new("Frame")
	HotbarFrame.Name = "HotbarFrame"
	HotbarFrame.BackgroundTransparency = 1
	HotbarFrame.AnchorPoint = Vector2.new(1, 0.5)
	HotbarFrame.Size = UDim2.new(0.4, 0, 0.1, 0)
	HotbarFrame.Position = UDim2.new(0.95, 0, 0.85, 0)
	HotbarFrame.Parent = Gui

	local Layout = Instance.new("UIListLayout")
	Layout.FillDirection = Enum.FillDirection.Horizontal
	Layout.VerticalAlignment = Enum.VerticalAlignment.Center
	Layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	Layout.Padding = UDim.new(0.025, 0)
	Layout.Parent = HotbarFrame

	local Aspect = Instance.new("UIAspectRatioConstraint")
	Aspect.AspectRatio = 3.238
	Aspect.Parent = HotbarFrame

	for i = 1, 5 do
		local slot = CreateSlot(i, false)
		slot.LayoutOrder = i
		slot.Parent = HotbarFrame
	end

	InventoryFrame = Instance.new("Frame")
	InventoryFrame.Name = "InventoryFrame"
	InventoryFrame.BackgroundTransparency = 0.5
	InventoryFrame.BackgroundColor3 = Color3.fromRGB(8, 36, 102)
	InventoryFrame.BorderSizePixel = 0
	InventoryFrame.AnchorPoint = Vector2.new(1, 0.5)
	InventoryFrame.Size = UDim2.new(0.285, 285, 0.402, 0)
	InventoryFrame.Position = UDim2.new(0.964, 0, 0.725, 0)
	InventoryFrame.Visible = false
	InventoryFrame.ZIndex = 0
	InventoryFrame.Parent = Gui

	local InnerShadow = Instance.new("UIShadow")
	InnerShadow.BlurRadius = UDim.new(0.1, 0)
	InnerShadow.Color = InventoryFrame.BackgroundColor3
	InnerShadow.Transparency = 0.5
	InnerShadow.Name = "InnerShadow"
	InnerShadow.Parent = InventoryFrame

	local OuterShadow = Instance.new("UIShadow")
	OuterShadow.BlurRadius = UDim.new(0.5, 0)
	OuterShadow.Color = Color3.new(0, 0, 0)
	OuterShadow.Spread = UDim2.new(0.75, 0,0.75, 0)
	OuterShadow.Transparency = 0.75
	OuterShadow.Name = "OuterShadow"
	OuterShadow.Parent = InventoryFrame

	local Gradient = Instance.new("UIGradient")
	Gradient.Name = "Gradient"
	Gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 90, 90)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
	})
	Gradient.Parent = InventoryFrame
	Gradient.Rotation = 90

	InventorySlotsFrame = Instance.new("Frame")
	InventorySlotsFrame.Name = "InventorySlotsFrame"
	InventorySlotsFrame.BackgroundTransparency = 1
	InventorySlotsFrame.BorderSizePixel = 0
	InventorySlotsFrame.AnchorPoint = Vector2.new(1, 0.5)
	InventorySlotsFrame.Size = UDim2.new(0.925, 0, 0.25, 0)
	InventorySlotsFrame.Position = UDim2.new(0.963, 0, 0.185, 0)
	InventorySlotsFrame.Parent = InventoryFrame

	local InvLayout = Instance.new("UIListLayout")
	InvLayout.FillDirection = Enum.FillDirection.Horizontal
	InvLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	InvLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	InvLayout.Padding = UDim.new(0.025, 0)
	InvLayout.Parent = InventorySlotsFrame

	local InventoryAspect = Instance.new("UIAspectRatioConstraint")
	InventoryAspect.AspectRatio = 1.508
	InventoryAspect.Parent = InventoryFrame

	for i = 1, 5 do
		local slot = CreateSlot(i, true)
		slot.LayoutOrder = i
		slot.Parent = InventorySlotsFrame
	end

	for i = 1, 5 do
		ContextActionService:BindAction("Slot" .. i, EquipSlot, false, Enum.KeyCode[({ "One", "Two", "Three", "Four", "Five" })[i]])
	end

	local TabConnection = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.Tab then
			InventoryFrame.Visible = not InventoryFrame.Visible
		end
	end)
	table.insert(TrackingRefs, TabConnection)

	local DragEndConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not DraggingTool then return end
		local mousePos = UserInputService:GetMouseLocation()

		for i = 1, 5 do
			local slot = HotbarFrame:FindFirstChild("Slot" .. i) :: Frame?
			if slot then
				local pos = slot.AbsolutePosition
				local size = slot.AbsoluteSize
				if mousePos.X >= pos.X and mousePos.X <= pos.X + size.X and mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y then
					for k, v in pairs(CurrentHotbar) do if v == DraggingTool then CurrentHotbar[k] = nil end end
					local idx = table.find(InventoryTools, DraggingTool)
					if idx then table.remove(InventoryTools, idx) end

					local old = CurrentHotbar[i]
					if old then table.insert(InventoryTools, old) end
					CurrentHotbar[i] = DraggingTool
					UpdateHotbar()
					EndDrag()
					return
				end
			end
		end

		local invPos = InventoryFrame.AbsolutePosition
		local invSize = InventoryFrame.AbsoluteSize
		if mousePos.X >= invPos.X and mousePos.X <= invPos.X + invSize.X and mousePos.Y >= invPos.Y and mousePos.Y <= invPos.Y + invSize.Y then
			for k, v in pairs(CurrentHotbar) do if v == DraggingTool then CurrentHotbar[k] = nil end end
			if not table.find(InventoryTools, DraggingTool) then table.insert(InventoryTools, DraggingTool) end
		end
		UpdateHotbar()
		EndDrag()
	end)
	table.insert(TrackingRefs, DragEndConnection)

	local DEBUG_AMMO_PRINTS = false

	local lastAmmoDebugPrint = 0

	local AmmoLoopConnection = RunService.Heartbeat:Connect(function()
		local debugTick = false
		if DEBUG_AMMO_PRINTS and os.clock() - lastAmmoDebugPrint > 1 then
			lastAmmoDebugPrint = os.clock()
			debugTick = true
		end

		if HotbarFrame then
			for i = 1, 5 do
				local slot = HotbarFrame:FindFirstChild("Slot" .. i) :: Frame?
				if slot then
					local tool = ResolveLiveTool(CurrentHotbar[i])
					if debugTick and tool then
						print(string.format(
							"[AmmoDebug] hotbar slot %d: tool=%s parent=%s CurrentAmmo=%s Local_CurrentAmmo=%s",
							i,
							tool.Name,
							tool.Parent and tool.Parent.Name or "nil",
							tostring(tool:GetAttribute("CurrentAmmo")),
							tostring(tool:GetAttribute("Local_CurrentAmmo"))
							))
					end
					local ok, err = pcall(UpdateSlotAmmo, slot, tool)
					if not ok then
						warn("[Inventory] ammo update failed for hotbar slot " .. i .. ": " .. tostring(err))
					end
				end
			end
		end

		if InventorySlotsFrame then
			for i = 1, 5 do
				local slot = InventorySlotsFrame:FindFirstChild("Slot" .. i) :: Frame?
				if slot then
					local tool = ResolveLiveTool(InventoryTools[i])
					if debugTick and tool then
						print(string.format(
							"[AmmoDebug] inventory slot %d: tool=%s parent=%s CurrentAmmo=%s Local_CurrentAmmo=%s",
							i,
							tool.Name,
							tool.Parent and tool.Parent.Name or "nil",
							tostring(tool:GetAttribute("CurrentAmmo")),
							tostring(tool:GetAttribute("Local_CurrentAmmo"))
							))
					end
					local ok, err = pcall(UpdateSlotAmmo, slot, tool)
					if not ok then
						warn("[Inventory] ammo update failed for inventory slot " .. i .. ": " .. tostring(err))
					end
				end
			end
		end
	end)
	table.insert(TrackingRefs, AmmoLoopConnection)

	local RenderConnection = RunService.RenderStepped:Connect(function()
		if DragFrame then
			local pos = UserInputService:GetMouseLocation()
			DragFrame.Position = UDim2.fromOffset(pos.X, pos.Y)
		end

		if HotbarFrame and not AmoLabel then
			AmoLabel = Instance.new("TextLabel")
			AmoLabel.Name = "AmoLabel"
			AmoLabel.Size = UDim2.new(1, 0, 0.35, 0)
			AmoLabel.Position = UDim2.new(0, 0, -1, 0)
			AmoLabel.BackgroundTransparency = 1
			AmoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			AmoLabel.Font = Enum.Font.Arimo
			AmoLabel.TextScaled = true
			AmoLabel.TextXAlignment = Enum.TextXAlignment.Right
			AmoLabel.Parent = HotbarFrame
		end

		if not Hud then
			local Home = Player.PlayerGui:FindFirstChild("Home")
			local actualHud = Home and Home:FindFirstChild("hud")
			if actualHud then Hud = actualHud :: Frame end
		end

		if Character and AmoLabel then
			local Tool = Character:FindFirstChildWhichIsA("Tool")
			if Tool then
				AmoLabel.Visible = true
				if Hud then
					local bFrame = Hud:FindFirstChild("BottomRightFrame") :: Frame?
					if bFrame then bFrame.Visible = false end
				end
				local current = Tool:GetAttribute("Local_CurrentAmmo") or Tool:GetAttribute("Local_CurrentAmo")
				local max = Tool:GetAttribute("MaxAmmo") or Tool:GetAttribute("MaxAmo")
				AmoLabel.Text = (current and max) and (tostring(current) .. " | " .. tostring(max)) or ""
			else
				if Hud then
					local bFrame = Hud:FindFirstChild("BottomRightFrame") :: Frame?
					if bFrame then bFrame.Visible = true end
				end
				AmoLabel.Visible = false
			end
		end

	end)
	table.insert(TrackingRefs, RenderConnection)

	local function SetupCharacter(char: Model)
		Character = char
		Backpack = Player:WaitForChild("Backpack") :: Backpack

		CleanConnections()
		table.clear(InventoryTools)
		for i = 1, 5 do CurrentHotbar[i] = nil end

		for _, tool in ipairs(Backpack:GetChildren()) do if tool:IsA("Tool") then RegisterTool(tool) end end
		for _, tool in ipairs(Character:GetChildren()) do if tool:IsA("Tool") then RegisterTool(tool) end end
		UpdateHotbar()

		table.insert(charConnections, Character.ChildAdded:Connect(function(c) if c:IsA("Tool") then RegisterTool(c); UpdateHotbar() end end))
		table.insert(charConnections, Backpack.ChildAdded:Connect(function(c) if c:IsA("Tool") then RegisterTool(c); UpdateHotbar() end end))
		table.insert(charConnections, Character.ChildRemoved:Connect(function(c) task.wait(); if c:IsA("Tool") and c.Parent ~= Character and c.Parent ~= Backpack then RemoveTool(c); UpdateHotbar() end end))
		table.insert(charConnections, Backpack.ChildRemoved:Connect(function(c) task.wait(); if c:IsA("Tool") and c.Parent ~= Character and c.Parent ~= Backpack then RemoveTool(c); UpdateHotbar() end end))
	end

	local CharAddedConn = Player.CharacterAdded:Connect(SetupCharacter)
	table.insert(TrackingRefs, CharAddedConn)
	if Player.Character then SetupCharacter(Player.Character) end

	while true do
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)

		ClientFramework.Heartbeats.Inventory = os.clock()
		task.wait(1)
	end
end

ClientFramework.Modules.Hitmarker = function()
	ClientFramework.ActiveUI.Hitmarker = ClientFramework.ActiveUI.Hitmarker or {}
	local TrackingRefs = ClientFramework.ActiveUI.Hitmarker

	local TargetParent: Instance
	if gethui then
		TargetParent = gethui()
	elseif RunService:IsStudio() then
		TargetParent = Player:WaitForChild("PlayerGui")
	else
		TargetParent = game:GetService("CoreGui")
	end

	local GlobalFeed = ReplicatedStorage:WaitForChild("Killfeed") :: Folder

	local VOLUME = 0.85
	local KillSounds = {
