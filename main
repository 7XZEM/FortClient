	}

	local function PlaySound(soundId: string, volume: number)
		local sound = Instance.new("Sound")
		sound.SoundId = soundId
		sound.Volume = volume or VOLUME
		sound.Parent = TargetParent
		sound:Play()

		sound.Ended:Connect(function()
			sound:Destroy()
		end)
		Debris:AddItem(sound, 5)
	end

	local lastHealth = {}
	local eliminatedPlayers = {}
	local shieldBroken = {}
	local recentTargets = {}
	local feedVersion = 0
	local activeTweenIn
	local activeTweenOut
	local lastShotTime = 0

	local CharConn = Player.CharacterAdded:Connect(function()
		lastHealth = {}
		eliminatedPlayers = {}
		shieldBroken = {}
		recentTargets = {}
	end)
	table.insert(TrackingRefs, CharConn)

	local HitmarkerGui = Instance.new("ScreenGui") :: ScreenGui
	HitmarkerGui.Name = "HitmarkerGui"
	HitmarkerGui.DisplayOrder = 10
	HitmarkerGui.ResetOnSpawn = false
	HitmarkerGui.Parent = TargetParent
	table.insert(TrackingRefs, HitmarkerGui)

	local KillFeedLabel = Instance.new("TextLabel")
	KillFeedLabel.Name = "EliminatedLabel"
	KillFeedLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	KillFeedLabel.Size = UDim2.new(0.55, 0, 0, 50)
	KillFeedLabel.Position = UDim2.new(0.5, 0, 0.65, 0)
	KillFeedLabel.BackgroundTransparency = 1
	KillFeedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	KillFeedLabel.TextStrokeTransparency = 1
	KillFeedLabel.TextTransparency = 1
	KillFeedLabel.Font = Enum.Font.ArimoBold
	KillFeedLabel.TextSize = 25
	KillFeedLabel.RichText = true
	KillFeedLabel.Parent = HitmarkerGui

	local function ShowKillFeed(victimName: string)
		feedVersion += 1
		local myVersion = feedVersion

		if activeTweenIn then activeTweenIn:Cancel() end
		if activeTweenOut then activeTweenOut:Cancel() end

		KillFeedLabel.Text =
			'<font color="rgb(255,255,255)">ELIMINATED: </font>' ..
			'<font color="rgb(255,60,60)"><b>' .. string.upper(victimName) .. '</b></font>'

		KillFeedLabel.TextTransparency = 1
		KillFeedLabel.TextStrokeTransparency = 1

		activeTweenIn = TweenService:Create(KillFeedLabel, TweenInfo.new(0.2), {
			TextTransparency = 0,
			TextStrokeTransparency = 0.5
		})
		activeTweenIn:Play()

		task.delay(2, function()
			if myVersion ~= feedVersion then return end

			activeTweenOut = TweenService:Create(KillFeedLabel, TweenInfo.new(0.25), {
				TextTransparency = 1,
				TextStrokeTransparency = 1,
			})
			activeTweenOut:Play()
		end)
	end

	local function CreatePopUp(targetPart: Instance, damageAmount: number, colorType: string?)
		if not targetPart or damageAmount <= 0 then return end

		local damageString = tostring(math.floor(damageAmount))
		local finalColor = Color3.fromRGB(255, 255, 255)

		if colorType == "Shield" then 
			finalColor = Color3.fromRGB(0, 170, 255)
		elseif colorType == "Kill" then 
			finalColor = Color3.fromRGB(232, 215, 23) 
		end

		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.new(0, 400, 0, 300)
		billboard.AlwaysOnTop = true
		billboard.Adornee = targetPart
		billboard.Parent = targetPart
		billboard.StudsOffset = Vector3.new(-3.5, 3.5, 0)

		local labels = {}
		local digitCount = #damageString
		local spacing = 28
		local totalWidth = digitCount * spacing

		for i = 1, digitCount do
			local label = Instance.new("TextLabel")
			label.Text = damageString:sub(i, i)
			label.Font = Enum.Font.LuckiestGuy
			label.TextSize = 35
			label.TextScaled = false
			label.TextColor3 = finalColor
			label.TextStrokeTransparency = 0
			label.BackgroundTransparency = 1

			local x = (i - 1) * spacing - (totalWidth / 2) + (spacing / 2)
			label.Position = UDim2.new(0.5, x, 0.5, 0)
			label.Size = UDim2.new(0, 35, 0, 50)

			label.Parent = billboard
			table.insert(labels, label)
		end

		task.spawn(function()
			TweenService:Create(
				billboard,
				TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In),{
					Size = UDim2.new(0, 300, 0, 200),
					StudsOffset = Vector3.new(0, 2, 0)
				}
			):Play()

			for _, label in ipairs(labels) do
				TweenService:Create(
					label,
					TweenInfo.new(0.35, Enum.EasingStyle.Linear),
					{Size = UDim2.new(0, 25, 0, 50)}
				):Play()
			end

			local gravity = 0.77
			local baseRotSpeed = 5
			local motions = {}

			for i, label in ipairs(labels) do
				local mid = (digitCount + 1) / 2
				local isRightSide = i > mid

				motions[label] = {
					velX = isRightSide and math.random(6, 10)/100 or math.random(-10, -6)/100,
					rotSpeed = (isRightSide and 1 or -1) * baseRotSpeed
				}
			end

			task.wait(0.4)

			for frame = 1, 55 do
				for _, label in ipairs(labels) do
					local motion = motions[label]
					label.Position = label.Position + UDim2.new(0, motion.velX * 100, 0, 5 + gravity)
					label.Rotation = label.Rotation + motion.rotSpeed

					local t = frame / 15
					local scale = (1 - t)^2
					label.Size = UDim2.new(0, 25 * scale, 0, 50 * scale)

					local fade = math.clamp(t, 0, 1)
					label.TextTransparency = fade
					label.TextStrokeTransparency = fade
				end
				RunService.RenderStepped:Wait()
			end

			billboard:Destroy()
		end)
	end

	local FeedConnection = GlobalFeed.ChildAdded:Connect(function(child: Instance)
		local feedText = child.Name
		local myUser = Player.Name

		local killerUser, victimUser = string.match(feedText, "^.-%s*%(%@([%w_]+)%)%s+killed%s+([%w_]+)")

		if killerUser and string.lower(killerUser) == string.lower(myUser) then
			if victimUser then
				ShowKillFeed(victimUser)
			end
		end
	end)
	table.insert(TrackingRefs, FeedConnection)

	local function ProcessMouseTarget()
		local char = Player.Character
		if not char then return end

		local Mouse = Player:GetMouse()
		local target = Mouse.Target

		if target and target.Parent then
			local enemyModel = target:FindFirstAncestorOfClass("Model")
			local hum = enemyModel and enemyModel:FindFirstChildOfClass("Humanoid")

			if hum and hum.Health > 0 and enemyModel ~= char then
				if not lastHealth[enemyModel] then
					lastHealth[enemyModel] = hum.Health
				end

				recentTargets[enemyModel] = {
					Hum = hum,
					Part = target,
					LastSeen = tick()
				}
			end
		end
	end

	local RenderConnection = RunService.RenderStepped:Connect(function()
		local char = Player.Character
		if not char then return end

		local Mouse = Player:GetMouse()
		local tool = char:FindFirstChildOfClass("Tool")

		if tool then
			Mouse.TargetFilter = tool
		else
			Mouse.TargetFilter = char
		end

		local isShooting = tool and tool:GetAttribute("Local_IsShooting")

		if isShooting then
			lastShotTime = tick()
			ProcessMouseTarget()
		end

		if tick() - lastShotTime > 1.5 and not isShooting then
			if next(recentTargets) ~= nil then recentTargets = {} end
			return 
		end

		for enemyModel, data in pairs(recentTargets) do
			local hum = data.Hum
			local part = data.Part
			local currentHP = hum.Health
			local previousHP = lastHealth[enemyModel] or currentHP

			if currentHP < previousHP then
				local damage = previousHP - currentHP
				local isDead = (currentHP <= 0)

				if isDead and not eliminatedPlayers[enemyModel] then
					eliminatedPlayers[enemyModel] = true
					local chosenSound = KillSounds[math.random(1, #KillSounds)]
					local calcVolume = 1

					if chosenSound == "rbxasset://sounds/Elimination3.mp3" then
						calcVolume = 0.5
					elseif table.find({"rbxasset://sounds/Elimination5.mp3", "rbxasset://sounds/Elimination7.mp3", "rbxasset://sounds/Elimination10.mp3"}, chosenSound) then	
						calcVolume = 0.15
					elseif table.find({"rbxasset://sounds/Elimination6.mp3", "rbxasset://sounds/Elimination8.mp3", "rbxasset://sounds/Elimination4.mp3"}, chosenSound) then	
						calcVolume = 2.5
					elseif chosenSound == "rbxasset://sounds/Elimination1.mp3" then
						calcVolume = 7
					end

					PlaySound(chosenSound, calcVolume)
					CreatePopUp(part, damage, "Kill")

					recentTargets[enemyModel] = nil
					lastHealth[enemyModel] = nil
				elseif not eliminatedPlayers[enemyModel] then
					if currentHP > 50 then
						local chosenSound = SheildHitSounds[math.random(1, #SheildHitSounds)]
						local calcVolume = (chosenSound == "rbxasset://sounds/SheildHit4.mp3") and 0.75 or 5
						PlaySound(chosenSound, calcVolume)
						CreatePopUp(part, damage, "Shield")
					elseif previousHP > 50 and currentHP <= 50 and not shieldBroken[enemyModel] then
						shieldBroken[enemyModel] = true
						local chosenSound = SheildCrackSounds[math.random(1, #SheildCrackSounds)]
						PlaySound(chosenSound, 0.75)
						CreatePopUp(part, damage, "Shield")
					else
						local chosenSound = HitSounds[math.random(1, #HitSounds)]
						local calcVolume = 10
						if chosenSound == "rbxasset://sounds/Hit3.mp3" then calcVolume = 0.75
						elseif chosenSound == "rbxasset://sounds/Hit2.mp3" then calcVolume = 2.5 end

						PlaySound(chosenSound, calcVolume)
						CreatePopUp(part, damage)
					end
				end
			end

			lastHealth[enemyModel] = currentHP

			if tick() - data.LastSeen > 2.0 then
				recentTargets[enemyModel] = nil
				lastHealth[enemyModel] = nil
			end
		end
	end)
	table.insert(TrackingRefs, RenderConnection)

	while true do
		ClientFramework.Heartbeats.Hitmarker = os.clock()
		task.wait(1)
	end
end

ClientFramework.Modules.AntiFling = function()
	ClientFramework.ActiveUI.AntiFling = ClientFramework.ActiveUI.AntiFling or {}
	local TrackingRefs = ClientFramework.ActiveUI.AntiFling

	local OriginalCollisions = {}
	local CarConnectionsMap = {}
	local GlobalConnections = {}

	local CarContainer = Workspace:WaitForChild("CarContainer")

	local function restorePart(part: Instance)
		if part:IsA("BasePart") and OriginalCollisions[part] ~= nil then
			part.CanCollide = OriginalCollisions[part].CanCollide
			part.CanTouch = OriginalCollisions[part].CanTouch
			OriginalCollisions[part] = nil
		end
	end

	local function clearCarTracking(car: Instance)
		
		if CarConnectionsMap[car] then
			for _, conn in ipairs(CarConnectionsMap[car]) do
				conn:Disconnect()
			end
			CarConnectionsMap[car] = nil
		end

		for _, descendant in ipairs(car:GetDescendants()) do
			restorePart(descendant)
		end
	end

	local function defusePart(part: Instance)
		if part:IsA("BasePart") then
			if OriginalCollisions[part] == nil then
				OriginalCollisions[part] = {
					CanCollide = part.CanCollide,
					CanTouch = part.CanTouch
				}
			end

			part.CanCollide = false
			part.CanTouch = false
		end
	end

	local function defuseCar(car: Instance)
		if CarConnectionsMap[car] then return end
		CarConnectionsMap[car] = {}

		for _, descendant in ipairs(car:GetDescendants()) do
			defusePart(descendant)
		end

		local descendantConn = car.DescendantAdded:Connect(defusePart)
		table.insert(CarConnectionsMap[car], descendantConn)

		local ancestryConn
		ancestryConn = car.AncestryChanged:Connect(function(_, parent)
			if not parent or not car:IsDescendantOf(Workspace) then
				clearCarTracking(car)
			end
		end)
		table.insert(CarConnectionsMap[car], ancestryConn)
	end

	local function disableAntiFling()
		
		for car, _ in pairs(CarConnectionsMap) do
			clearCarTracking(car)
		end
		table.clear(CarConnectionsMap)

		for part, _ in pairs(OriginalCollisions) do
			restorePart(part)
		end
		table.clear(OriginalCollisions)
	end

	local childAddedConn = CarContainer.ChildAdded:Connect(function(car)
		if GlobalSettings.AntiFling then
			defuseCar(car)
		end
	end)
	table.insert(GlobalConnections, childAddedConn)

	local RenderConnection = RunService.RenderStepped:Connect(function()
		if GlobalSettings.AntiFling then
			for _, car in ipairs(CarContainer:GetChildren()) do
				defuseCar(car)
			end
		else
			if next(OriginalCollisions) ~= nil or next(CarConnectionsMap) ~= nil then
				disableAntiFling()
			end
		end
	end)
	table.insert(GlobalConnections, RenderConnection)

	for _, conn in ipairs(GlobalConnections) do
		table.insert(TrackingRefs, conn)
	end

	while true do
		ClientFramework.Heartbeats.AntiFling = os.clock()
		task.wait(1)
	end
end

-- This functionality is deprecated and will no longer be maintained.
ClientFramework.Modules.EmoteWheel = function()

	warn("EmoteWheel module is deprecated and will no longer be maintained, please use roblox's native emote wheel instead.")

	local ALLOW_MOVEMENT_DURING_EMOTE = false


	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")

	local LocalPlayer = Players.LocalPlayer :: Player
	local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local Humanoid = Character:WaitForChild("Humanoid") :: Humanoid

	local currentSound: Sound? = nil
	local customAnimConnection: RBXScriptConnection? = nil 
	local isOpen = false
	local moveConn: RBXScriptConnection? = nil
	local currentlyHoveredEmote = nil

	local function getPoses(poseList, folder)
		folder = folder or {}
		for _, pose in ipairs(poseList) do
			if pose:IsA("Pose") then
				folder[pose.Name] = pose.CFrame
				local subPoses = pose:GetChildren()
				if #subPoses > 0 then
					getPoses(subPoses, folder)
				end
			end
		end
		return folder
	end

	local function findMotor(partName)
		for _, descendant in ipairs(Character:GetDescendants()) do
			if descendant:IsA("Motor6D") and descendant.Part1 and descendant.Part1.Name == partName then
				return descendant
			end
		end
		return nil
	end

	local function StopCurrentEmote()
		if customAnimConnection then
			customAnimConnection:Disconnect()
			customAnimConnection = nil
		end

		if currentSound then
			local oldSound = currentSound
			currentSound = nil

			TweenService:Create(oldSound, TweenInfo.new(0.5), {Volume = 0}):Play()
			task.delay(1, function() 
				if oldSound then oldSound:Destroy() end 
			end)
		end
	end

	local EmoteDatabase = {
		[1] = { Name = "Zany", CustomFile = "Animations/Zany.rbxm", Icon = "rbxassetid://102754860575266", SoundId = "rbxasset://sounds/EmoteSounds/Zany.ogg", Looped = true },
		[2] = { Name = "Dance Moves", CustomFile = "Animations/Dance_Moves.rbxm", Icon = "rbxassetid://80542755544719", SoundId = "rbxasset://sounds/EmoteSounds/Dance_Moves.ogg", Looped = false },
	}

	local function ConnectMovementCancel(targetHumanoid: Humanoid)
		if moveConn then moveConn:Disconnect() end
		if ALLOW_MOVEMENT_DURING_EMOTE then return end

		local rootPart = targetHumanoid.RootPart or Character:WaitForChild("HumanoidRootPart", 5)
		if not rootPart then return end

		moveConn = RunService.Heartbeat:Connect(function()
			if not customAnimConnection then return end

			local horizontalVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
			local movementThreshold = 0

			if horizontalVelocity.Magnitude > movementThreshold or targetHumanoid.MoveDirection.Magnitude > 0.1 then
				StopCurrentEmote()
			end
		end)
	end

	local function PlayCustomOptimized(fileData: any)
		local localAssetPath = getcustomasset(fileData.CustomFile)
		local success, loadedObjects = pcall(function()
			return game:GetObjects(localAssetPath)
		end)

		if not success or not loadedObjects or #loadedObjects == 0 then
			warn("Failed to read file! Make sure your executor workspace contains: " .. tostring(fileData.CustomFile))
			return nil
		end

		local sequence = loadedObjects[1]
		if not sequence:IsA("KeyframeSequence") then
			warn("The loaded file must be a KeyframeSequence.")
			sequence:Destroy()
			return nil
		end

		local cachedTimeline = {}
		local motorCache = {}

		local rawKeyframes = sequence:GetKeyframes()
		table.sort(rawKeyframes, function(a, b) return a.Time < b.Time end)

		for _, kf in ipairs(rawKeyframes) do
			local framePoses = getPoses(kf:GetChildren())

			table.insert(cachedTimeline, {
				Time = kf.Time,
				Poses = framePoses
			})

			for partName in pairs(framePoses) do
				if not motorCache[partName] then
					motorCache[partName] = findMotor(partName)
				end
			end
		end

		local animationLength = cachedTimeline[#cachedTimeline].Time
		sequence:Destroy()

		local startTime = os.clock()

		local connection
		connection = RunService.PreSimulation:Connect(function()
			local elapsed = os.clock() - startTime

			if not fileData.Looped and elapsed >= animationLength then
				StopCurrentEmote()
				return
			end

			local currentTime = elapsed % animationLength

			local frameA = cachedTimeline[1]
			local frameB = cachedTimeline[#cachedTimeline]

			for i = 1, #cachedTimeline - 1 do
				if currentTime >= cachedTimeline[i].Time and currentTime <= cachedTimeline[i + 1].Time then
					frameA = cachedTimeline[i]
					frameB = cachedTimeline[i + 1]
					break
				end
			end

			local timeDelta = frameB.Time - frameA.Time
			local alpha = (timeDelta > 0) and ((currentTime - frameA.Time) / timeDelta) or 0

			for partName, motor in pairs(motorCache) do
				if motor then
					local cframeA = frameA.Poses[partName]

					if not cframeA then
						for i = #cachedTimeline, 1, -1 do
							if cachedTimeline[i].Time <= currentTime and cachedTimeline[i].Poses[partName] then
								cframeA = cachedTimeline[i].Poses[partName]
								break
							end
						end
					end

					local cframeB = frameB.Poses[partName] or cframeA
					if not frameB.Poses[partName] then
						for i = 1, #cachedTimeline do
							if cachedTimeline[i].Time > currentTime and cachedTimeline[i].Poses[partName] then
								cframeB = cachedTimeline[i].Poses[partName]
								break
							end
						end
					end

					if cframeA and cframeB then
						motor.Transform = cframeA:Lerp(cframeB, alpha)
					end
				end
			end
		end)

		return connection
	end

	local function PlayEmote(emoteData: any)
		if not Humanoid or not Humanoid:IsDescendantOf(workspace) then return end

		StopCurrentEmote()

		local localSound: Sound? = nil
		if emoteData.SoundId and emoteData.SoundId ~= "" then
			local targetRoot = Humanoid.RootPart
			if targetRoot then
				local sound = Instance.new("Sound")
				sound.Name = "EmoteAudioSource"
				sound.SoundId = emoteData.SoundId
				sound.Volume = 0.2

				if emoteData.Looped then			
					sound.Looped = true
				end	
				sound.Parent = targetRoot
				sound:Play()

				currentSound = sound
				localSound = sound
			end
		end

		if emoteData.CustomFile and emoteData.CustomFile ~= "" then
			customAnimConnection = PlayCustomOptimized(emoteData)
		end
	end

	local TargetGuiParent = LocalPlayer.PlayerGui

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "FrameworkEmoteWheel"
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	ScreenGui.Parent = TargetGuiParent

	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "Main"
	MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	MainFrame.Size = UDim2.new(0.4, 0, 0.4, 0)
	MainFrame.BackgroundTransparency = 1
	MainFrame.Visible = false
	MainFrame.Parent = ScreenGui

	local AspectConstraint = Instance.new("UIAspectRatioConstraint")
	AspectConstraint.AspectRatio = 1
	AspectConstraint.Parent = MainFrame

	local SizeConstraint = Instance.new("UISizeConstraint")
	SizeConstraint.MinSize = Vector2.new(200, 200)
	SizeConstraint.MaxSize = Vector2.new(350, 350)
	SizeConstraint.Parent = MainFrame

	local BackgroundImage = Instance.new("ImageLabel")
	BackgroundImage.Name = "BackgroundImage"
	BackgroundImage.Size = UDim2.new(1, 0, 1, 0)
	BackgroundImage.BackgroundTransparency = 0.3
	BackgroundImage.ZIndex = 1
	BackgroundImage.Image = ""
	BackgroundImage.BackgroundColor3 = Color3.new(0.0313726, 0.141176, 0.4)
	BackgroundImage.ImageTransparency = 1
	BackgroundImage.Parent = MainFrame

	local RoundingCorner = Instance.new("UICorner")
	RoundingCorner.CornerRadius = UDim.new(0.5, 0)
	RoundingCorner.Parent = BackgroundImage

	local InnerShadow = Instance.new("UIShadow")
	InnerShadow.BlurRadius = UDim.new(0.1, 0)
	InnerShadow.Color = BackgroundImage.BackgroundColor3
	InnerShadow.Transparency = 0.5
	InnerShadow.Name = "InnerShadow"
	InnerShadow.Parent = BackgroundImage

	local OuterShadow = Instance.new("UIShadow")
	OuterShadow.BlurRadius = UDim.new(1, 0)
	OuterShadow.Color = Color3.new(0, 0, 0)
	OuterShadow.Spread = UDim2.new(1, 0, 1, 0)
	OuterShadow.Transparency = 0.5
	OuterShadow.Name = "OuterShadow"
	OuterShadow.Parent = BackgroundImage

	local Frame = Instance.new("Frame")
	Frame.AnchorPoint = Vector2.new(0.5, 0.5)
	Frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	Frame.Size = UDim2.new(0.35, 0, 0.35, 0)
	Frame.BackgroundColor3 = Color3.fromRGB(4, 16, 45)
	Frame.Parent = BackgroundImage

	local RoundingCorner = Instance.new("UICorner")
	RoundingCorner.CornerRadius = UDim.new(0.5, 0)
	RoundingCorner.Parent = Frame

	local OuterShadow = Instance.new("UIShadow")
	OuterShadow.BlurRadius = UDim.new(0.5, 0)
	OuterShadow.Color = Frame.BackgroundColor3
	OuterShadow.Spread = UDim2.new(0.5, 0, 0.5, 0)
	OuterShadow.Transparency = 0.75
	OuterShadow.Name = "OuterShadow"
	OuterShadow.Parent = Frame

	local CentralText = Instance.new("TextLabel")
	CentralText.Name = "MiddleText"
	CentralText.AnchorPoint = Vector2.new(0.5, 0.5)
	CentralText.Position = UDim2.new(0.5, 0, 0.5, 0)
	CentralText.Size = UDim2.new(0.6, 0, 0.4, 0)
	CentralText.BackgroundTransparency = 1
	CentralText.ZIndex = 5
	CentralText.Font = Enum.Font.BuilderSans
	CentralText.Text = "Select Emote"
	CentralText.TextColor3 = Color3.new(1, 1, 1)
	CentralText.TextScaled = true
	CentralText.Parent = Frame

	ConnectMovementCancel(Humanoid)

	local radius = 0.35 
	for index = 1, #EmoteDatabase do
		local data = EmoteDatabase[index]
		if not data then continue end

		local angle = ((index - 1) / 8) * (2 * math.pi) - (math.pi / 2)
		local posX = 0.5 + (math.cos(angle) * radius)
		local posY = 0.5 + (math.sin(angle) * radius)

		local Button = Instance.new("ImageButton")
		Button.Name = tostring(index)
		Button.AnchorPoint = Vector2.new(0.5, 0.5)
		Button.Position = UDim2.new(posX, 0, posY, 0)
		Button.Size = UDim2.new(0.16, 0, 0.16, 0)
		Button.BackgroundTransparency = 1
		Button.ZIndex = 4
		Button.Image = data.Icon
		Button.ImageColor3 = Color3.fromRGB(200, 200, 200)
		Button.Parent = MainFrame

		local UIAspect = Instance.new("UIAspectRatioConstraint")
		UIAspect.AspectRatio = 1
		UIAspect.Parent = Button

		local Label = Instance.new("TextLabel")
		Label.Name = "SlotLabel"
		Label.AnchorPoint = Vector2.new(0.5, 0)
		Label.Position = UDim2.new(0.5, 0, 1, 2)
		Label.Size = UDim2.new(1.5, 0, 0.25, 0)
		Label.BackgroundTransparency = 1
		Label.Font = Enum.Font.BuilderSans
		Label.Text = data.Name
		Label.TextColor3 = Color3.new(1, 1, 1)
		Label.TextScaled = true
		Label.ZIndex = 5
		Label.Parent = Button

		Button.MouseEnter:Connect(function()
			currentlyHoveredEmote = data
			CentralText.Text = data.Name
			TweenService:Create(Label, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(255, 226, 2)}):Play()
			TweenService:Create(Button, TweenInfo.new(0.15), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
			TweenService:Create(Button, TweenInfo.new(0.15), {Size = UDim2.new(0.175, 0, 0.175, 0)}):Play()
		end)

		Button.MouseLeave:Connect(function()
			if currentlyHoveredEmote == data then
				currentlyHoveredEmote = nil
			end
			CentralText.Text = "Select Emote"
			TweenService:Create(Label, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
			TweenService:Create(Button, TweenInfo.new(0.15), {ImageColor3 = Color3.fromRGB(200, 200, 200)}):Play()
			TweenService:Create(Button, TweenInfo.new(0.15), {Size = UDim2.new(0.16, 0, 0.16, 0)}):Play()
		end)

		Button.MouseButton1Down:Connect(function()
			PlayEmote(data)
			isOpen = false
			MainFrame.Visible = false
		end)
	end

	local InputBeganConn = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.B then
			isOpen = true
			MainFrame.Visible = true
		end
	end)

	local InputEndedConn = UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.B and isOpen then
			isOpen = false
			MainFrame.Visible = false

			if currentlyHoveredEmote then
				PlayEmote(currentlyHoveredEmote)
			end
		end
	end)

	local CharAddedConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
		Character = newChar
		Humanoid = newChar:WaitForChild("Humanoid") :: Humanoid
		StopCurrentEmote()
		ConnectMovementCancel(Humanoid)
	end)

	ClientFramework.ActiveUI.EmoteWheel = ClientFramework.ActiveUI.EmoteWheel or {}
	table.insert(ClientFramework.ActiveUI.EmoteWheel, ScreenGui)
	table.insert(ClientFramework.ActiveUI.EmoteWheel, InputBeganConn)
	table.insert(ClientFramework.ActiveUI.EmoteWheel, InputEndedConn)
	table.insert(ClientFramework.ActiveUI.EmoteWheel, CharAddedConn)

	while true do
		ClientFramework.Heartbeats.EmoteWheel = os.clock()
		task.wait(1)
	end
end


warn("[FortClient] Deploying threads...")
for moduleName, _ in pairs(ClientFramework.Modules) do
	BootCompoment(moduleName)
end

task.spawn(function()
	while true do
		task.wait(5)
		local currentTime = os.clock()

		for moduleName, lastPulse in pairs(ClientFramework.Heartbeats) do
			local timeSinceLastPulse = currentTime - lastPulse

			if timeSinceLastPulse > TIMEOUT_THRESHOLD then
				warn("[Watchdog CRITICAL] Module '" .. moduleName .. "' crashed? No response for " .. string.format("%.1f", timeSinceLastPulse) .. " seconds.")
				RebootComponent(moduleName)
			end
		end
	end
end)
