	local HealthIcon = Instance.new("ImageLabel")
	HealthIcon.BackgroundTransparency = 1
	HealthIcon.Image = "rbxassetid://136567904544031"
	HealthIcon.Position = UDim2.new(-0.085, 0, 0, 0)
