	HealthIcon.ZIndex = 3
	HealthIcon.Parent = HealthFrame

	local AspectRatio = Instance.new("UIAspectRatioConstraint")
	AspectRatio.AspectRatio = 6.617
	AspectRatio.Parent = Holder

	local UiListlayout = Instance.new("UIListLayout")
	UiListlayout.FillDirection = Enum.FillDirection.Vertical
	UiListlayout.SortOrder = Enum.SortOrder.LayoutOrder
	UiListlayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	UiListlayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	UiListlayout.Padding = UDim.new(0.1, 0)
	UiListlayout.Parent = Holder

	local function FindRiotShield(): Tool?
		local backpack = Player:FindFirstChild("Backpack")
		local shield = backpack and backpack:FindFirstChild("Riot Shield")

		if not shield and Player.Character then
			shield = Player.Character:FindFirstChild("Riot Shield")
		end
		return shield :: Tool?
	end

	local function GetExternalShieldFrame(): Frame?
		local home = PlayerGui:FindFirstChild("Home")
		local hud = home and home:FindFirstChild("hud")
		return (hud and hud:FindFirstChild("ShieldHealthFrame")) :: Frame?
	end

	local function UpdateBars()
		local char = Player.Character
		if not char then return end

		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end

		local currentHealth = humanoid.Health
		local displayShield = math.clamp(currentHealth - MAX_HP, 0, MAX_SHIELD)
		local displayHP = math.clamp(currentHealth, 0, MAX_HP)

		ShieldText.Text = string.format("%d | %d", displayShield, MAX_SHIELD)
		HealthText.Text = string.format("%d | %d", displayHP, MAX_HP)

		TweenService:Create(ShieldProgress, TWEEN_INFO, { Size = UDim2.new(displayShield / MAX_SHIELD, 0, 1, 0) }):Play()
		TweenService:Create(HealthProgress, TWEEN_INFO, { Size = UDim2.new(displayHP / MAX_HP, 0, 1, 0) }):Play()

		local riotShield = FindRiotShield()
		local externalShieldFrame = GetExternalShieldFrame()

		if riotShield then
			local rshHealth = riotShield:GetAttribute("Health") or 0
			local rshMaxHealth = riotShield:GetAttribute("MaxHealth") or 100

			if rshMaxHealth <= 0 then rshMaxHealth = 100 end 

			RiotShieldText.Text = string.format("%d | %d", rshHealth, rshMaxHealth)

			if not RiotShieldFrame.Visible then
				RiotShieldFrame.Visible = true
				Spacer.Visible = false
			end

			if externalShieldFrame and externalShieldFrame.Visible then
				externalShieldFrame.Visible = false
			end

			TweenService:Create(RiotShieldProgress, TWEEN_INFO, { Size = UDim2.new(math.clamp(rshHealth / rshMaxHealth, 0, 1), 0, 1, 0) }):Play()
		else
			if RiotShieldFrame.Visible then
				RiotShieldFrame.Visible = false
				Spacer.Visible = true
			end
		end
	end

	game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)

	local Connection = RunService.Heartbeat:Connect(UpdateBars)
	table.insert(TrackingRefs, Connection)

	while true do

		ClientFramework.Heartbeats.HealthHUD = os.clock()
		task.wait(1)
	end
end

ClientFramework.Modules.KillFeed = function()
	ClientFramework.ActiveUI.KillFeed = ClientFramework.ActiveUI.KillFeed or {}
	local TrackingRefs = ClientFramework.ActiveUI.KillFeed

	local TargetParent: Instance
	if gethui then
		TargetParent = gethui()
	elseif RunService:IsStudio() then
		TargetParent = Player:WaitForChild("PlayerGui")
	else
		TargetParent = game:GetService("CoreGui")
	end

	local GlobalFeed = ReplicatedStorage:WaitForChild("Killfeed") :: Folder

	local KillfeedGui = Instance.new("ScreenGui") :: ScreenGui
	KillfeedGui.Name = "GlobalkillFeed"
	KillfeedGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	KillfeedGui.DisplayOrder = 3
	KillfeedGui.Parent = TargetParent
	KillfeedGui.ResetOnSpawn = false
	table.insert(TrackingRefs, KillfeedGui)

	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "Holder"
	MainFrame.Position = UDim2.new(0.05, 0, 0.71, 0)
	MainFrame.Size = UDim2.new(0.5, 0, 0.085, 0)
	MainFrame.AnchorPoint = Vector2.new(0, 0.5)
	MainFrame.BackgroundTransparency = 1
	MainFrame.BorderSizePixel = 0
	MainFrame.ZIndex = 1
	MainFrame.Parent = KillfeedGui

	local UiListlayout = Instance.new("UIListLayout")
	UiListlayout.FillDirection = Enum.FillDirection.Vertical
	UiListlayout.SortOrder = Enum.SortOrder.LayoutOrder
	UiListlayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	UiListlayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	UiListlayout.Padding = UDim.new(0.1, 0)
	UiListlayout.Parent = MainFrame

	local FeedAspect = Instance.new("UIAspectRatioConstraint")
	FeedAspect.AspectRatio = 6.617
	FeedAspect.Parent = MainFrame

local function CreateFeed(Feed: IntValue, Parent: Instance)
	if Feed then
		local FeedFrame = Instance.new("Frame")
		FeedFrame.Name = Feed.Name
		FeedFrame.Size = UDim2.new(1, 0, 0.5, 0)
		FeedFrame.BackgroundTransparency = 0.5
		FeedFrame.BackgroundColor3 = Color3.fromRGB(8, 36, 102)
		FeedFrame.BorderSizePixel = 0
		FeedFrame.ZIndex = 1
		FeedFrame.Parent = MainFrame

		local InnerShadow = Instance.new("UIShadow")
		InnerShadow.BlurRadius = UDim.new(0.1, 0)
		InnerShadow.Color = FeedFrame.BackgroundColor3
		InnerShadow.Transparency = 1
		InnerShadow.Name = "InnerShadow"
		InnerShadow.Parent = FeedFrame

		local OuterShadow = Instance.new("UIShadow")
		OuterShadow.BlurRadius = UDim.new(1, 0)
		OuterShadow.Color = Color3.new(0, 0, 0)
		OuterShadow.Spread = UDim2.new(0.1, 0, 0.1, 0)
		OuterShadow.Transparency = 1
		OuterShadow.Name = "OuterShadow"
		OuterShadow.Parent = FeedFrame

		local Gradient = Instance.new("UIGradient")
		Gradient.Name = "Gradient"
		Gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 150, 150)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
		})
		Gradient.Parent = FeedFrame
		Gradient.Rotation = 90

		local FeedLabel = Instance.new("TextLabel")
		FeedLabel.BackgroundTransparency = 1
		FeedLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		FeedLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
		FeedLabel.Size = UDim2.new(0.95, 0, 0.95, 0)
		FeedLabel.ZIndex = 2
		FeedLabel.Font = Enum.Font.LuckiestGuy
		FeedLabel.TextScaled = true
		FeedLabel.TextTransparency = 1
		FeedLabel.TextStrokeTransparency = 1
		FeedLabel.TextXAlignment = Enum.TextXAlignment.Left
		FeedLabel.TextYAlignment = Enum.TextYAlignment.Bottom
		FeedLabel.RichText = true
		FeedLabel.Parent = FeedFrame

		local function toHex(c: Color3)
			return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
		end

		local function GetColorFromAnyName(nameStr: string)
			local cleanName = string.lower(nameStr)
			for _, p in ipairs(Players:GetPlayers()) do
				if string.lower(p.DisplayName) == cleanName or string.lower(p.Name) == cleanName then
					if p.TeamColor then
						return p.TeamColor.Color
					end
				end
			end
		   return Color3.fromRGB(255, 64, 0)
		end

		local rawText = Feed.Name
		
		local killerDisplay, killerUser, action, victimText, weapon = string.match(rawText, "^(.-)%s*%(%@([%w_]+)%)%s+(%a+)%s+([%w_]+)%s+(.*)$")

		if killerUser and victimText then
			local killerColor = GetColorFromAnyName(killerUser)
			local victimColor = GetColorFromAnyName(victimText)

			local formattedKiller = string.format("%s (@%s)", killerDisplay, killerUser)

			FeedLabel.Text = string.format(
				'<font color="%s">%s</font> <font color="rgb(255,255,255)">%s</font> <font color="%s">%s</font> <font color="rgb(255,255,255)">%s</font>',
				toHex(killerColor), formattedKiller,
				action,
				toHex(victimColor), victimText,
				weapon
			)
		else
			FeedLabel.Text = string.format('<font color="rgb(255,255,255)">%s</font>', rawText)
		end

		local Info = TweenInfo.new(0.75, Enum.EasingStyle.Sine)

		TweenService:Create(FeedFrame, Info, {BackgroundTransparency = 0.5}):Play()
		TweenService:Create(FeedLabel, Info, {TextTransparency = 0}):Play()
		TweenService:Create(InnerShadow, Info, {Transparency = 0.5}):Play()
		TweenService:Create(OuterShadow, Info, {Transparency = 0.3}):Play()
		task.wait(5)
		TweenService:Create(FeedFrame, Info, {BackgroundTransparency = 1}):Play()
		TweenService:Create(FeedLabel, Info, {TextTransparency = 1}):Play()
		TweenService:Create(InnerShadow, Info, {Transparency = 1}):Play()
		TweenService:Create(OuterShadow, Info, {Transparency = 1}):Play()
		task.wait(1)
		FeedLabel.Visible = false

		Debris:AddItem(FeedFrame, 3)
	end
end
	
	local FeedConnection = GlobalFeed.ChildAdded:Connect(function(child: Instance)
		if child:IsA("IntValue") then
			CreateFeed(child, MainFrame)
		end
	end)

	table.insert(TrackingRefs, FeedConnection)

	while true do
		ClientFramework.Heartbeats.KillFeed = os.clock()
		task.wait(1)
	end

end

