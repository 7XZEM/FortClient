local TIMEOUT_THRESHOLD = 15

local function Destroyer(Table: { any })
	if not Table then return end

	for i = #Table, 1, -1 do
		local VALUE = Table[i]

		if typeof(VALUE) == "RBXScriptConnection" then
			VALUE:Disconnect()
		elseif typeof(VALUE) == "Instance" then
			VALUE:Destroy()
		end
	end

	table.clear(Table)
end

local function BootCompoment(moduleName: string)
	warn("[Watchdog] Initiating: " .. moduleName)

	if ClientFramework.ActiveUI[moduleName] then
		Destroyer(ClientFramework.ActiveUI[moduleName])
	else
		ClientFramework.ActiveUI[moduleName] = {}
	end

	ClientFramework.Heartbeats[moduleName] = os.clock()

	task.spawn(ClientFramework.Modules[moduleName])
end

local function RebootComponent(moduleName: string)
	warn("[Watchdog] Initiating recovery sequence for: " .. moduleName)

	if ClientFramework.ActiveUI[moduleName] then
		Destroyer(ClientFramework.ActiveUI[moduleName])
	else
		ClientFramework.ActiveUI[moduleName] = {}
	end

	ClientFramework.Heartbeats[moduleName] = os.clock()

	task.spawn(ClientFramework.Modules[moduleName])
end

