	ShieldText.Font = Enum.Font.ArimoBold
	ShieldText.TextXAlignment = Enum.TextXAlignment.Left
	ShieldText.ZIndex = 2
	ShieldText.Parent = ShieldFrame

	local RiotShieldText = Instance.new("TextLabel")
	RiotShieldText.Name = "RiotShieldText"
	RiotShieldText.BackgroundTransparency = 1
	RiotShieldText.TextColor3 = Color3.fromRGB(255, 255, 255)
	RiotShieldText.AnchorPoint = Vector2.new(0.5, 0.5)
	RiotShieldText.Position = UDim2.new(0.5, 0, 0.5, 0)
	RiotShieldText.Size = UDim2.new(0.95, 0, 0.85, 0)
	RiotShieldText.TextScaled = true
	RiotShieldText.Font = Enum.Font.ArimoBold
	RiotShieldText.TextXAlignment = Enum.TextXAlignment.Left
	RiotShieldText.ZIndex = 2
	RiotShieldText.Parent = RiotShieldFrame

	local HealthText = Instance.new("TextLabel")
	HealthText.Name = "HealthText"
	HealthText.BackgroundTransparency = 1
	HealthText.TextColor3 = Color3.fromRGB(255, 255, 255)
	HealthText.AnchorPoint = Vector2.new(0.5, 0.5)
	HealthText.Position = UDim2.new(0.5, 0, 0.5, 0)
	HealthText.Size = UDim2.new(0.95, 0, 0.85, 0)
	HealthText.TextScaled = true
