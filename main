	local BG_COLOR = Color3.fromRGB(19, 40, 59)
	local HP_COLOR = Color3.fromRGB(117, 225, 70)
	local SHIELD_COLOR = Color3.fromRGB(80, 168, 245)
	local RIOT_SHIELD_COLOR = Color3.fromRGB(208, 150, 14)
	local TWEEN_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local START_COLOR = Color3.fromRGB(165, 165, 165)
	local END_COLOR = Color3.fromRGB(255, 255, 255)

	local function CreateProgressBar(name: string, parent: Instance, color: Color3): Frame
		local Bar = Instance.new("Frame")
		Bar.Name = name .. "Progress"
		Bar.Size = UDim2.new(1, 0, 1, 0)
		Bar.BackgroundColor3 = color
		Bar.BorderSizePixel = 0
		Bar.ZIndex = 0
		Bar.Parent = parent

		local Gradient = Instance.new("UIGradient")
		Gradient.Name = "Gradient"
		Gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, START_COLOR),
			ColorSequenceKeypoint.new(1, END_COLOR)
		})
		Gradient.Parent = Bar

		local UiShadow = Instance.new("UIShadow")
		UiShadow.Transparency = 0
		UiShadow.Color = Bar.BackgroundColor3
		UiShadow.BlurRadius = UDim.new(0.5, 0)
		UiShadow.Spread = UDim2.new(0.025, 0, 0.025, 0)
		UiShadow.Parent = Bar
		UiShadow.Enabled = GlobalSettings.UIShadowsEnabled

		return Bar
	end

	local TargetParent: Instance
	if gethui then
		TargetParent = gethui()
	elseif RunService:IsStudio() then
		TargetParent = Player:WaitForChild("PlayerGui")
	else
		TargetParent = game:GetService("CoreGui")
	end

	local PlayerGui = Player:WaitForChild("PlayerGui") :: PlayerGui

	local HealthGui = Instance.new("ScreenGui")
	HealthGui.Name = "HealthGuiClient"
	HealthGui.ResetOnSpawn = false 
	HealthGui.Parent = TargetParent
	table.insert(TrackingRefs, HealthGui)

	local Holder = Instance.new("Frame")
	Holder.Name = "HealthHolder"
	Holder.BackgroundTransparency = 1
	Holder.AnchorPoint = Vector2.new(0, 0.5)
	Holder.Size = UDim2.new(0.5, 0, 0.085, 0)
	Holder.Position = UDim2.new(0.05, 0, 0.85, 0)
	Holder.Parent = HealthGui

	local ShieldFrame = Instance.new("Frame")
	ShieldFrame.Name = "ShieldFrame"
	ShieldFrame.BackgroundColor3 = BG_COLOR
	ShieldFrame.BackgroundTransparency = 0.4
	ShieldFrame.AnchorPoint = Vector2.new(0.5, 0)
	ShieldFrame.Size = UDim2.new(1, 0, 0.45, 0)
	ShieldFrame.BorderSizePixel = 0
	ShieldFrame.ZIndex = -1
	ShieldFrame.Parent = Holder
	ShieldFrame.LayoutOrder = 1

	local HealthFrame = Instance.new("Frame")
	HealthFrame.Name = "HealthFrame"
	HealthFrame.BackgroundColor3 = BG_COLOR
	HealthFrame.BackgroundTransparency = 0.4
	HealthFrame.AnchorPoint = Vector2.new(0.5, 1)
	HealthFrame.Size = UDim2.new(1, 0, 0.45, 0)
	HealthFrame.BorderSizePixel = 0
	HealthFrame.ZIndex = -1
	HealthFrame.Parent = Holder
	HealthFrame.LayoutOrder = 2

	local RiotShieldFrame = Instance.new("Frame")
	RiotShieldFrame.Name = "RiotShieldFrame"
	RiotShieldFrame.BackgroundColor3 = BG_COLOR
	RiotShieldFrame.BackgroundTransparency = 0.4
	RiotShieldFrame.AnchorPoint = Vector2.new(0.5, 0)
	RiotShieldFrame.Size = UDim2.new(1, 0, 0.45, 0)
	RiotShieldFrame.BorderSizePixel = 0
	RiotShieldFrame.ZIndex = -1
	RiotShieldFrame.Parent = Holder
	RiotShieldFrame.LayoutOrder = 0
	RiotShieldFrame.Visible = false

	local Spacer = Instance.new("Frame")
	Spacer.Name = "Spacer"
	Spacer.BackgroundTransparency = 1
	Spacer.AnchorPoint = Vector2.new(0.5, 0)
	Spacer.Size = UDim2.new(1, 0, 0.45, 0)
	Spacer.BorderSizePixel = 0
	Spacer.ZIndex = -1
	Spacer.Parent = Holder
	Spacer.LayoutOrder = 0
	Spacer.Visible = true

	local RiotShieldProgress = CreateProgressBar("RiotShield", RiotShieldFrame, RIOT_SHIELD_COLOR)
	local ShieldProgress = CreateProgressBar("Shield", ShieldFrame, SHIELD_COLOR)
	local HealthProgress = CreateProgressBar("Health", HealthFrame, HP_COLOR)

	local ShieldText = Instance.new("TextLabel")
	ShieldText.Name = "ShieldText"
	ShieldText.BackgroundTransparency = 1
	ShieldText.TextColor3 = Color3.fromRGB(255, 255, 255)
	ShieldText.AnchorPoint = Vector2.new(0.5, 0.5)
	ShieldText.Position = UDim2.new(0.5, 0, 0.5, 0)
	ShieldText.Size = UDim2.new(0.95, 0, 0.85, 0)
