	local CharacterAddedConnection = Player.CharacterAdded:Connect(function(NewCharacter: Model)
		if NewCharacter then
			Character = NewCharacter
			Humanoid = Character:FindFirstChildWhichIsA("Humanoid")
		end
	end)
	table.insert(TrackingRefs, CharacterAddedConnection)

	local boundTools: { [Instance]: boolean } = {}

	local function startDistanceSwapper(handle: BasePart, settings: any)
		local shootSound = handle:WaitForChild("ShootSound", 10)
		if not shootSound or not shootSound:IsA("Sound") then return end
		local shootSoundObject: Sound = shootSound :: Sound

		shootSoundObject.RollOffMinDistance = settings.MinDistance or 10
		shootSoundObject.RollOffMaxDistance = settings.MaxDistance or 2500

		local connection: RBXScriptConnection
		connection = RunService.Heartbeat:Connect(function()
			if not handle or not handle.Parent or not handle:IsDescendantOf(workspace) then 
				connection:Disconnect()
				return 
			end

			if not GlobalSettings.ModdedWeapons then return end

			local cam = workspace.CurrentCamera
			if not cam then return end

			local dist = (handle.Position - cam.CFrame.Position).Magnitude
			local targetId = ""

			if dist < (settings.MidStart or 150) then
				targetId = settings.ShootSoundId.Near
			elseif dist < (settings.FarStart or 600) then
				targetId = settings.ShootSoundId.Mid
			else
				targetId = settings.ShootSoundId.Far
			end

			if shootSoundObject.SoundId ~= targetId then
				shootSoundObject.SoundId = targetId
			end
		end)
	end

	local function applyWeaponModifications(tool: Instance)
		if not tool:IsA("Tool") then return end
		local weaponTool: Tool = tool :: Tool

		local settings: any = (weaponSettings :: any)[weaponTool.Name]
		if not settings then return end

		for attrName: string, attrValue: any in pairs(settings) do
			if type(attrValue) ~= "table" then
				weaponTool:SetAttribute(attrName, attrValue)
			end
		end

		local handle: Instance? = weaponTool:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			local baseHandle: BasePart = handle :: BasePart
			local shootData: any = settings["ShootSoundId"]

			if GlobalSettings.ModdedWeapons then
				if type(shootData) == "table" then
					startDistanceSwapper(baseHandle, settings)
				elseif type(shootData) == "string" then
					local soundObj: Instance? = baseHandle:FindFirstChild("ShootSound")
					if soundObj and soundObj:IsA("Sound") then 
						(soundObj :: Sound).SoundId = shootData 
					end
				end

				if settings.ReloadSoundId then
					local reloadObj: Instance? = baseHandle:FindFirstChild("ReloadSound")
					if reloadObj and reloadObj:IsA("Sound") then 
						(reloadObj :: Sound).SoundId = settings.ReloadSoundId 
					end
				end

				if settings.SecondarySoundId then
					local SecondObj: Instance? = baseHandle:FindFirstChild("SecondarySound")
					if SecondObj and SecondObj:IsA("Sound") then 
						(SecondObj :: Sound).SoundId = settings.SecondarySoundId 
					end
				end
			end
		end

		if settings.EquipSoundId and settings.EquipSoundId ~= "" and not boundTools[weaponTool] then
			boundTools[weaponTool] = true

			local targetParent: Instance = handle or weaponTool
			local equipSound: Instance? = targetParent:FindFirstChild("EquipSound")

			if not equipSound then
				local newSound = Instance.new("Sound")
				newSound.Name = "EquipSound"
				newSound.SoundId = settings.EquipSoundId
				newSound.Volume = 0.6
				newSound.Parent = targetParent
				equipSound = newSound
			end

			local soundObj: Sound = equipSound :: Sound

			local equipConn = weaponTool.Equipped:Connect(function()
				local character: Instance? = weaponTool.Parent
				if character and character:IsA("Model") and Players:GetPlayerFromCharacter(character :: Model) == Player then
					if GlobalSettings.ModdedWeapons then
						soundObj:Play()
					end
				end
			end)
			table.insert(TrackingRefs, equipConn)

			local destroyConn = weaponTool.Destroying:Connect(function()
				boundTools[weaponTool] = nil
			end)
			table.insert(TrackingRefs, destroyConn)
		end
	end

	local function setupCharacter(char: Model)
		local childAddedConn = char.ChildAdded:Connect(applyWeaponModifications)
		table.insert(TrackingRefs, childAddedConn)

		for _, item: Instance in pairs(char:GetChildren()) do
			if item:IsA("Tool") then
				applyWeaponModifications(item) 
			end
		end
	end

	local function observePlayer(plr: Player)
		local charAddedConn = plr.CharacterAdded:Connect(setupCharacter)
		table.insert(TrackingRefs, charAddedConn)
		if plr.Character then setupCharacter(plr.Character) end

		if plr == Player then
			local backpack: Backpack? = plr:FindFirstChildOfClass("Backpack")
			if backpack then
				local bpAddedConn = backpack.ChildAdded:Connect(applyWeaponModifications)
				table.insert(TrackingRefs, bpAddedConn)

				for _, item: Instance in pairs(backpack:GetChildren()) do
					if item:IsA("Tool") then
						applyWeaponModifications(item)
					end
				end
			end
		end
	end

	local playerAddedConn = Players.PlayerAdded:Connect(observePlayer)
	table.insert(TrackingRefs, playerAddedConn)
	for _, plr in pairs(Players:GetPlayers()) do
		observePlayer(plr)
	end

	local function getDoorsModel()
		if Doors and Doors.Parent then return Doors end 

		return workspace:FindFirstChild("Doors") or ReplicatedStorage:FindFirstChild("Doors")
	end

	local function updatePlayerHighlight(player)
		if player == LocalPlayer then return end

		local character = player.Character
		if character and character:FindFirstChild("HumanoidRootPart") then
			local highlight = character:FindFirstChild("Highlight") :: Highlight

			if GlobalSettings.ESP then
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Name = "Highlight"
					highlight.FillTransparency = 1
					highlight.OutlineTransparency = 0
					highlight.Parent = character
				end

				if player.Team then
					highlight.OutlineColor = player.TeamColor.Color
				else
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				end
			elseif highlight then
				highlight:Destroy()
			end
		end
	end

	local playerAddedConn = Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.1)
			updatePlayerHighlight(player)
		end)
	end)

	while true do

		if LocalPlayer.Character then
			if not Humanoid or Humanoid.Parent ~= LocalPlayer.Character then
				Humanoid = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid") :: Humanoid
			end
			if Humanoid then
				Humanoid.WalkSpeed = GlobalSettings.Speedboost and 25 or 16
			end
		end

		if Camera then
			if GlobalSettings.FovBoost and Camera.FieldOfView == 70 then
				Camera.FieldOfView = 87
			elseif not GlobalSettings.FovBoost and Camera.FieldOfView == 87 then
				Camera.FieldOfView = 70
			end
		end

		if GlobalSettings.ESP then
			for _, targetPlayer in ipairs(Players:GetPlayers()) do
				updatePlayerHighlight(targetPlayer)
			end
		else
			for _, targetPlayer in ipairs(Players:GetPlayers()) do
				if targetPlayer.Character then
					local highlight = targetPlayer.Character:FindFirstChild("Highlight")
					if highlight then highlight:Destroy() end
				end
			end
		end

		if GlobalSettings.DisableAntiJump then
			if LocalPlayer.Character:FindFirstChild("AntiJump") then
				LocalPlayer.Character.AntiJump.Disabled = true
			end
		else
			if LocalPlayer.Character:FindFirstChild("AntiJump") then
				LocalPlayer.Character.AntiJump.Disabled = false
			end
		end

		local doorModel = getDoorsModel()
		if doorModel then
			Doors = doorModel
			local targetParent = GlobalSettings.DoorsDisabled and ReplicatedStorage or workspace
			if Doors.Parent ~= targetParent then
				Doors.Parent = targetParent
			end
		end

		if ClientFramework and ClientFramework.Heartbeats then
			ClientFramework.Heartbeats.SettingsMenu = os.clock()
		end

		task.wait(1)
	end
end

